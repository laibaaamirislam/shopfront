
<!-- app/views/admin/categories/index.html.erb -->
<div class="content-card p-4 p-md-5" style="background-color: #FAF6F0; border-radius: 4px;">

  <%# Header Block %>
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <p class="eyebrow">Overview</p>
      <h1 class="product-title mb-0">Categories</h1>
    </div>

    <%= link_to "+ New Category", 
                new_admin_category_path, 
                class: "btn btn-dark btn-sm rounded-0 px-3" %>
  </div>

  <hr class="mt-0 mb-4" style="border-color: rgba(0, 0, 0, 0.08);">

  <%# Table Area %>
<% if @categories.any? %>
  <div class="table-responsive">
    <table class="table align-middle mb-0" style="--bs-table-bg: transparent;">
      <thead>
        <tr style="border-bottom: 1px solid rgba(0, 0, 0, 0.12);">
          <th class="nav-caps text-uppercase py-3 ps-0">Category Name</th>
          <th class="nav-caps text-uppercase py-3">Products</th>
          <th class="nav-caps text-uppercase py-3">Actions</th>
        </tr>
      </thead>

      <tbody>
        <% @categories.each do |category| %>
          <tr style="border-bottom: 1px solid rgba(0, 0, 0, 0.06);">
            
            <%# Name %>
            <td class="py-3 ps-0">
              <%= link_to category.name,
                          admin_category_path(category),
                          class: "brand-wordmark fs-6" %>
            </td>

            <%# Product Count %>
            <td class="py-3">
              <span class="badge rounded-pill fw-normal px-3 py-2" style="background-color: #EFE9DF; color: #5C544B; font-size: 0.775rem;">
                <%= pluralize(category.products.count, "product") %>
              </span>
            </td>

            <%# Action Links (Now left-aligned with column header) %>
            <td class="py-3">
              <div class="d-inline-flex align-items-center gap-3">
                <%= link_to "Edit",
                            edit_admin_category_path(category),
                            class: "text-secondary text-decoration-none small hover-underline",
                            style: "font-size: 0.85rem; color: #6C757D;" %>

                <%= button_to "Delete",
                              admin_category_path(category),
                              method: :delete,
                              class: "btn btn-link text-danger text-decoration-none small p-0 m-0 border-0 align-baseline",
                              style: "font-size: 0.85rem; opacity: 0.85;",
                              data: { turbo_confirm: "Are you sure you want to delete '#{category.name}'?" },
                              form: { style: "display:inline;" } %>
              </div>
            </td>

          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-5">
    <p class="text-muted fst-italic mb-2" style="font-family: Georgia, serif; color: #8A7E72;">No categories found.</p>
    <%= link_to "Create your first category", new_admin_category_path, class: "text-dark small text-decoration-underline" %>
  </div>
<% end %>

</div>

