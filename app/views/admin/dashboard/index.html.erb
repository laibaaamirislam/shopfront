<!-- app/views/admin/dashboard/index.html.erb -->
<div class="content-card">

  <%# Header & Quick Actions %>
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-5 pb-4 border-bottom">
    <div>
      <span class="eyebrow text-uppercase text-muted mb-1 d-block" style="font-size: 0.7rem; letter-spacing: 0.12em;">Overview</span>
      <h1 class="product-title mb-0 fs-2 fw-medium">Dashboard</h1>
    </div>
    
    <div class="d-flex align-items-center gap-2">
      <span class="text-secondary small d-none d-sm-inline me-2" style="font-size: 0.85rem;">
        <%= Time.current.strftime("%B %d, %Y") %>
      </span>
      <%= link_to "Manage Products", admin_products_path, class: "btn btn-outline-dark btn-sm rounded-0 px-3 py-2 fw-normal" %>
      <%= link_to "+ New Product", new_admin_product_path, class: "btn btn-dark btn-sm rounded-0 px-3 py-2 fw-normal" %>
    </div>
  </div>

  <%# Connected Editorial Metrics Bar %>
  <div class="row g-0 mb-5 border border-light-subtle bg-white">
    <div class="col-md-4 border-bottom border-md-0 border-end-md border-light-subtle p-4">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <p class="nav-caps text-muted mb-0" style="font-size: 0.7rem; letter-spacing: 0.12em;">Total Revenue</p>
 
      </div>
      <div class="d-flex align-items-baseline gap-2">
        <span class="fs-2 font-serif text-dark fw-normal"><%= number_to_currency(@total_revenue) %></span>
      </div>
    </div>

    <div class="col-md-4 border-bottom border-md-0 border-end-md border-light-subtle p-4">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <p class="nav-caps text-muted mb-0" style="font-size: 0.7rem; letter-spacing: 0.12em;">Total Orders</p>
      </div>
      <div class="d-flex align-items-baseline gap-2">
        <span class="fs-2 font-serif text-dark fw-normal"><%= @order_count %></span>
      </div>
    </div>

    <div class="col-md-4 p-4">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <p class="nav-caps text-muted mb-0" style="font-size: 0.7rem; letter-spacing: 0.12em;">Low Stock Items</p>
      
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="fs-2 font-serif fw-normal <%= @low_stock_products.any? ? 'text-danger' : 'text-dark' %>">
          <%= @low_stock_products.count %>
        </span>
        <% if @low_stock_products.any? %>
          <span class="badge bg-danger-subtle text-danger border-0 fw-normal rounded-0 ms-1" style="font-size: 0.65rem; letter-spacing: 0.05em;">
            Action Required
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <%# Main Content Section %>
  <div class="row g-5">

    <%# Recent Orders Table %>
    <div class="<%= @low_stock_products.any? ? 'col-lg-7' : 'col-12' %>">
      <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-dark">
        <h2 class="h6 mb-0 fw-medium text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.1em;">Recent Orders</h2>
        <%= link_to "View All Orders →", admin_orders_path, class: "text-secondary text-decoration-none small hover-underline" %>
      </div>

      <% if @recent_orders.any? %>
        <div class="table-responsive">
          <table class="table align-middle mb-0" style="--bs-table-bg: transparent;">
            <thead>
              <tr class="text-muted border-bottom" style="font-size: 0.68rem; letter-spacing: 0.1em;">
                <th class="fw-normal text-uppercase pb-3 ps-0">Order</th>
                <th class="fw-normal text-uppercase pb-3">Customer</th>
                <th class="fw-normal text-uppercase pb-3">Total</th>
                <th class="fw-normal text-uppercase pb-3 text-end pe-0">Status</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_orders.each do |order| %>
                <tr class="border-bottom border-light-subtle">
                  <td class="py-3 ps-0 fw-medium">
                    <%= link_to "##{order.id}", 
                          admin_order_path(order), 
                          class: "text-dark text-decoration-none hover-underline" %>
                  </td>
                  <td class="py-3 text-secondary small" style="font-size: 0.85rem;"><%= order.user.email %></td>
                  <td class="py-3 small fw-medium" style="font-size: 0.85rem;"><%= number_to_currency(order.total_price) %></td>
                  <td class="py-3 text-end pe-0">
                  <span class="d-inline-flex align-items-center gap-2 px-2 py-1 bg-white border border-light-subtle text-secondary" style="font-size: 0.7rem; letter-spacing: 0.05em;">
          
                    <%= order.status.to_s.humanize %>
                  </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="py-4 text-center bg-white border border-light-subtle">
          <p class="text-secondary small mb-0">No recent orders recorded.</p>
        </div>
      <% end %>
    </div>

    <%# Low Stock Inventory Column %>
    <% if @low_stock_products.any? %>
      <div class="col-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-danger">
          <h2 class="h6 mb-0 fw-medium text-danger text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.1em;">Low Stock Alerts</h2>
        
        </div>

        <div class="bg-white p-4 border border-light-subtle">
          <ul class="list-unstyled mb-0">
            <% @low_stock_products.each_with_index do |product, index| %>
              <li class="d-flex justify-content-between align-items-center py-3 <%= 'border-bottom border-light-subtle' unless index == @low_stock_products.size - 1 %>">
                <div>
                  <%= link_to product.name, 
                        admin_product_path(product), 
                        class: "text-dark text-decoration-none small fw-medium hover-underline d-block mb-1" %>
                  <span class="text-muted small" style="font-size: 0.75rem;"><%= number_to_currency(product.price) %></span>
                </div>
                
                <div>
                  <span class="px-2 py-1 bg-danger-subtle text-danger small fw-medium rounded-0 d-inline-block" style="font-size: 0.75rem;">
                    <%= product.stock_quantity %> left
                  </span>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

  </div>

</div>