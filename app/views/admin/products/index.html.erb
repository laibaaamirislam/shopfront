<div class="content-card">

  <%# Header Block %>
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <p class="eyebrow">Overview</p>
      <h1 class="product-title mb-0">Products</h1>
    </div>

    <%= link_to "+ New Product", 
                new_admin_product_path, 
                class: "btn btn-dark btn-sm rounded-0 px-3" %>
  </div>

  <%# Products Table %>
  <div class="related-section">
    <div class="table-responsive">
      <table class="table align-middle mb-0" style="--bs-table-bg: transparent;">
        <thead>
          <tr class="border-bottom">
            <th class="nav-caps text-uppercase py-3 ps-0">Name</th>
            <th class="nav-caps text-uppercase py-3">Category</th>
            <th class="nav-caps text-uppercase py-3">Price</th>
            <th class="nav-caps text-uppercase py-3">Stock</th>
            <th class="nav-caps text-uppercase py-3">Sold</th>
            <th class="nav-caps text-uppercase py-3 text-end pe-0">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @products.each do |product| %>
            <tr class="border-bottom border-light">
              
              <%# Product Name %>
              <td class="py-3 ps-0">
                <%= link_to product.name, admin_product_path(product), class: "brand-wordmark fs-6" %>
              </td>

              <%# Category %>
              <td class="py-3">
                <span class="eyebrow mb-0"><%= product.category&.name || "Uncategorized" %></span>
              </td>

              <%# Price %>
              <td class="py-3">
                <span class="related-price"><%= number_to_currency(product.price) %></span>
              </td>

              <%# Stock %>
              <td class="py-3">
                <span class="badge rounded-pill fw-normal px-3 py-2" style="background-color: #EFE9DF; color: #5C544B; font-size: 0.67rem;">
                  <%= product.stock_quantity %> in stock
                </span>
              </td>

              <%# Sold Count %>
              <td class="py-3">
                <span class="related-price">
                  <%= product.respond_to?(:sales_count) ? product.sales_count : (product.try(:order_items)&.sum(:quantity) || 0) %>
                </span>
              </td>

              <%# Actions %>
              <td class="py-3 text-end pe-0">
                <div class="d-inline-flex align-items-center gap-3">
                  <%= link_to "Edit",
                              edit_admin_product_path(product),
                              class: "text-secondary text-decoration-none small hover-underline",
                              style: "font-size: 0.85rem; color: #6C757D;" %>

                  <%= button_to "Delete",
                                admin_product_path(product),
                                method: :delete,
                                class: "btn btn-link text-danger text-decoration-none small p-0 m-0 border-0 align-baseline",
                                style: "font-size: 0.85rem; opacity: 0.85;",
                                data: { turbo_confirm: "Delete this product?" },
                                form: { style: "display:inline;" } %>
                </div>
              </td>

            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>