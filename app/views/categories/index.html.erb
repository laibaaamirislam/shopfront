<!-- app/views/categories/index.html.erb -->
<div class="content-card">
  <h1 class="h4 mb-4">Categories</h1>
  <% @categories.each do |category| %>
    <p><%= link_to category.name, category_path(category), class: "text-decoration-none related-name" %></p>
  <% end %>
  <%= link_to "New Category", new_category_path, class: "btn btn-outline-editorial mt-3" %>
</div>