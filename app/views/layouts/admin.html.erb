<!-- app/views/layouts/admin.html.erb -->
<!DOCTYPE html>
<html>
  <head>
    <title>Shopfront Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light-subtle" style="background-color: #FAFAFA;">
    <div class="d-flex" style="min-height: 100vh;">

      <%# Editorial Admin Sidebar %>
      <aside class="bg-dark text-white p-4 d-flex flex-column justify-content-between" style="width: 240px; min-width: 240px;">
        <div>
          <%# Brand Header %>
          <div class="mb-5 pb-3 border-bottom border-secondary border-opacity-50">
            <span class="eyebrow text-uppercase text-white-50 d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.15em;">Control Center</span>
            <h2 class="h5 font-serif text-white mb-0 fw-normal">Shopfront Admin</h2>
          </div>

          <%# Navigation Links %>
          <nav class="nav flex-column gap-2">
            <p class="nav-caps text-white-50 mb-2" style="font-size: 0.65rem; letter-spacing: 0.12em;">Navigation</p>
            
            <%= link_to "Dashboard", 
                  admin_root_path, 
                  class: "nav-link px-0 py-1 text-decoration-none #{current_page?(admin_root_path) ? 'text-white fw-medium' : 'text-white-50'}" %>

            <%= link_to "Products", 
                  admin_products_path, 
                  class: "nav-link px-0 py-1 text-decoration-none #{current_page?(admin_products_path) ? 'text-white fw-medium' : 'text-white-50'}" %>

            <%= link_to "Categories", 
                  admin_categories_path, 
                  class: "nav-link px-0 py-1 text-decoration-none #{current_page?(admin_categories_path) ? 'text-white fw-medium' : 'text-white-50'}" %>

            <%= link_to "Orders", 
                  admin_orders_path, 
                  class: "nav-link px-0 py-1 text-decoration-none #{current_page?(admin_orders_path) ? 'text-white fw-medium' : 'text-white-50'}" %>
          </nav>
        </div>

        <%# Bottom Footer Actions %>
        <div class="pt-4 border-top border-secondary border-opacity-50">
          <%= link_to "← Back to Store", 
                root_path, 
                class: "text-white-50 text-decoration-none d-block mb-3 hover-underline", 
                style: "font-size: 0.8rem;" %>

          <%= button_to "Log Out", 
                logout_path, 
                method: :delete, 
                class: "btn btn-link text-white-50 p-0 text-decoration-none hover-underline", 
                style: "font-size: 0.8rem;",
                form: { style: "display:inline;" } %>
        </div>
      </aside>

      <%# Main Content Body %>
      <main class="flex-grow-1 p-4 p-md-5 overflow-auto">
        <%# Editorial Flash Messages %>
        <% flash.each do |type, message| %>
          <div class="alert <%= type == 'notice' ? 'bg-dark text-white' : 'bg-danger text-white' %> rounded-0 border-0 shadow-sm d-flex justify-content-between align-items-center mb-4 px-4 py-3" style="font-size: 0.85rem;" role="alert">
            <span><%= message %></span>
            <button type="button" class="btn-close btn-close-white ms-3" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>

        <%= yield %>
      </main>

    </div>
  </body>
</html>