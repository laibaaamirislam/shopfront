<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Shopfront" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>


  <body>
      
    <nav class="navbar navbar-expand-lg navbar-light bg-light mb-4">
      <div class="container">
        <%= link_to "Shopfront", root_path, class: "navbar-brand" %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <%= link_to "Products", products_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Add Product", new_product_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "About", about_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Contact", contact_path, class: "nav-link" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>


    <div class="container mb-5">
      <% flash.each do |type, message| %>
        <div class="alert <%= bootstrap_class_for(type) %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <footer class="bg-light text-center text-muted py-4 mt-5">
      <div class="container">
        &copy; <%= Date.current.year %> Shopfront. Built while learning Rails.
      </div>
    </footer>

  </body>
</html>
