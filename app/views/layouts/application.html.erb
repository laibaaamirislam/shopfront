<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Shopfront" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Playfair+Display:ital,wght@0,500;1,400&display=swap" rel="stylesheet">
  </head>

  <body>

    <nav class="d-flex justify-content-between align-items-center px-4 py-4">
      <%= link_to "Shopfront", root_path, class: "brand-wordmark" %>
      <div class="d-flex gap-4 align-items-center">
        <%= link_to "Categories", categories_path, class: "nav-caps" %>
        <%= link_to "Catalog", products_path, class: "nav-caps" %>
        <%= link_to "About", about_path, class: "nav-caps" %>
        <%= link_to "Contact", contact_path, class: "nav-caps" %>
        <%= link_to "Cart (#{current_cart.cart_items.sum(:quantity)})", cart_path, class: "nav-caps" %>

        <% if current_user&.admin? %>
          <%= link_to "Admin Dashboard", admin_root_path, class: "nav-caps" %>
        <% end %>  

        <% if current_user %>
          <%= link_to "My Orders", orders_path, class: "nav-caps" %>
          <%= button_to "Log Out", logout_path, method: :delete, class: "btn btn-outline-editorial btn-sm", form: { style: "display:inline;" } %>
        <% else %>
          <%= link_to "Log In", login_path, class: "nav-caps" %>
          <%= link_to "Sign Up", new_user_path, class: "nav-caps" %>
        <% end %>
      </div>
    </nav>

    <div class="container mb-5">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <footer class="bg-light text-center text-muted py-4 mt-5">
      <div class="container">
        &copy; <%= Date.current.year %> Shopfront. Built while learning Rails.
      </div>
    </footer>



  </body>
</html>