<!-- app/views/layouts/application.html.erb -->
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Shopfront" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Playfair+Display:ital,wght@0,500;1,400&display=swap" rel="stylesheet">
  </head>

  <body class="bg-white">

    <%# Editorial Navigation Bar %>
    <header class="border-bottom border-light-subtle mb-4">
      <nav class="container d-flex justify-content-between align-items-center py-4">
        
        <%# Brand Wordmark (Acts as the Home link) %>
        <%= link_to "Shopfront", root_path, class: "brand-wordmark fs-3 text-dark text-decoration-none fw-medium" %>

        <div class="d-flex gap-4 align-items-center">

          <% if current_user&.admin? %>
            <%# ADMIN NAVBAR %>
            <%= link_to "Admin Panel", admin_root_path, class: "btn btn-dark btn-sm rounded-0 px-3 py-1 fw-normal ms-2" %>
            <%= button_to "Log Out", logout_path, method: :delete, class: "btn btn-outline-dark btn-sm rounded-0 px-2 py-1 fw-normal ms-1", form: { style: "display:inline;" } %>

          <% elsif current_user %>
            <%# LOGGED-IN CUSTOMER NAVBAR: About, Contact, Cart, My Orders, Log Out %>
            <%= link_to "Catalog", products_path, class: "nav-caps text-secondary text-decoration-none hover-underline" %>
            <%= link_to "Cart (#{current_cart.cart_items.sum(:quantity)})", cart_path, class: "nav-caps text-dark text-decoration-none fw-medium" %>
            <%= link_to "My Orders", orders_path, class: "nav-caps text-secondary text-decoration-none hover-underline" %>
            <%= button_to "Log Out", logout_path, method: :delete, class: "btn btn-outline btn-sm rounded-0 px-2 py-1 fw-normal ms-1", form: { style: "display:inline;" } %>
            <%= link_to "My Account", user_path(current_user), class: "nav-caps" %>

  <div class="dropdown">
    <button class="btn btn-outline-dark btn-sm rounded-0 px-2 py-1 fw-normal ms-1 dropdown-toggle"
            type="button" data-bs-toggle="dropdown" aria-expanded="false">
      &#9776;
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
      <li><h6 class="dropdown-header"><%= current_user.email %></h6></li>
      <li><%= link_to "My Profile", user_path(current_user), class: "dropdown-item" %></li>
      <li><%= link_to "Edit Profile", edit_user_path(current_user), class: "dropdown-item" %></li>
      <li><hr class="dropdown-divider"></li>
      <li>
        <%= button_to "Log Out", logout_path, method: :delete,
            class: "dropdown-item", form: { style: "margin:0;" } %>
      </li>
      <li>
        <%= button_to "Delete Account", user_path(current_user), method: :delete,
            class: "dropdown-item text-danger",
            data: { turbo_confirm: "Delete your account? This cannot be undone." },
            form: { style: "margin:0;" } %>
      </li>
    </ul>
  </div>

          <% else %>
            <%# GUEST NAVBAR %>
            <%= link_to "Catalog", products_path, class: "nav-caps text-secondary text-decoration-none hover-underline" %>
            <%= link_to "About", about_path, class: "nav-caps text-secondary text-decoration-none hover-underline" %>
            <%= link_to "Contact", contact_path, class: "nav-caps text-secondary text-decoration-none hover-underline" %>
            
            <span class="text-light-subtle">|</span>
            
            <%= link_to "Sign In / Sign Up", login_path, class: "nav-caps text-secondary text-decoration-none hover-underline" %>
            <%= link_to "Admin Login", login_path, class: "btn btn-outline-dark btn-sm rounded-0 px-2 py-1 fw-normal ms-1" %>
          <% end %>

        </div>
      </nav>
    </header>

    <%# Main Container %>
    <div class="container mb-5">
      <% flash.each do |type, message| %>
        <div class="alert <%= type == 'notice' ? 'bg-dark text-white' : 'bg-danger text-white' %> rounded-0 border-0 shadow-sm d-flex justify-content-between align-items-center mb-4 px-4 py-3" style="font-size: 0.85rem;" role="alert">
          <span><%= message %></span>
          <button type="button" class="btn-close btn-close-white ms-3" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <%# Footer %>
    <footer class="border-top border-light-subtle py-4 mt-5">
      <div class="container text-center text-secondary small">
        &copy; <%= Date.current.year %> Shopfront. Built while learning Rails.
      </div>
    </footer>

  </body>
</html>