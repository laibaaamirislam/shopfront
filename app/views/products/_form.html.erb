
<%= form_with model: product, local: true do |form| %>
  <% if product.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(product.errors.count, "error") %> prohibited this product from saving:</h5>
      <ul class="mb-0">
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :image, "Product Photo", class: "form-label" %>
    <%= form.file_field :image, class: "form-control", accept: "image/*" %>
  </div>

  <div class="mb-3">
    <%= form.label :category_id, "Category", class: "form-label" %>
    <%= form.collection_select :category_id, Category.all, :id, :name,
        { prompt: "Select a category" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 4 %>
  </div>

  <div class="mb-3">
    <%= form.label :price, class: "form-label" %>
    <%= form.number_field :price, step: 0.01, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :stock_quantity, class: "form-label" %>
    <%= form.number_field :stock_quantity, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :sku, class: "form-label" %>
    <%= form.text_field :sku, class: "form-control" %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
<% end %>

