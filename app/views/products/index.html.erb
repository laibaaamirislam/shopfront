
<h1>All Products</h1>

<% @products.each do |product| %>
  <h2><%= link_to product.name, product_path(product) %></h2>
  <p><%= number_to_currency(product.price) %></p>
  <p><%= product.stock_quantity > 0 ? "In stock" : "Out of stock" %></p>
  <%= button_to "Delete", product_path(product), method: :delete,
    data: { turbo_confirm: "Remove this product?" } %>
  <hr>
<% end %>