<!-- app/views/products/index.html.erb -->
<h1 class="mb-4">All Products</h1>
<div class="row row-cols-1 row-cols-md-3 g-4">
  <% @products.each do |product| %>
    <div class="col">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title"><%= link_to product.name, product_path(product), class: "text-decoration-none" %></h5>
          <p class="related-name"><%= product.name %></p>
          <p class="eyebrow" style="margin-bottom:0;"><%= product.category&.name %></p>
          <p class="card-text"><%= number_to_currency(product.price) %></p>
          <span class="badge <%= product.stock_quantity > 0 ? 'bg-success' : 'bg-danger' %>">
            <%= product.stock_quantity > 0 ? "In stock" : "Out of stock" %>
          </span>
        </div>
      </div>
    </div>
  <% end %>
</div>