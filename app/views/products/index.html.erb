<!-- app/views/admin/products/index.html.erb -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Products</h1>
  <%= link_to "+ New Product", new_admin_product_path, class: "btn btn-dark btn-sm" %>
</div>

<table class="table">
  <thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th></th></tr></thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= link_to product.name, admin_product_path(product) %></td>
        <td><%= product.category&.name %></td>
        <td><%= number_to_currency(product.price) %></td>
        <td><%= product.stock_quantity %></td>
        <td>
          <%= link_to "Edit", edit_admin_product_path(product), class: "btn btn-sm btn-outline-secondary" %>
          <%= button_to "Delete", admin_product_path(product), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Delete this product?" }, form: { style: "display:inline;" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>