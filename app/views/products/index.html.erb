
<div class="content-card">
  <h1 class="h4 mb-2">All Products</h1>

  <%= form_with url: products_path, method: :get, local: true, class: "row g-2 mb-4" do |form| %>
    <div class="col-md-6">
      <%= form.text_field :query, value: params[:query], placeholder: "Search products...", class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= form.select :category_id, @categories.map { |c| [c.name, c.id] },
          { include_blank: "All categories", selected: params[:category_id] },
          { class: "form-select" } %>
    </div>
    <div class="col-md-4">
      <%= form.submit "Filter", class: "btn btn-outline-editorial w-100" %>
    </div>
  <% end %>

  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% @products.each do |product| %>
      <div class="col">
        <%= link_to product_path(product), class: "text-decoration-none" do %>
          <div class="product-image-block mb-2" style="aspect-ratio:1;">
            <% if product.image.attached? %>
              <%= image_tag product.image.variant(resize_to_fill: [400, 400]), alt: product.name %>
            <% end %>
          </div>
          <p class="related-name"><%= product.name %></p>
          <p class="eyebrow" style="margin-bottom:0;"><%= product.category&.name %></p>
          <p class="related-price"><%= number_to_currency(product.price) %></p>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @products.empty? %>
    <p class="product-desc mt-4">No products match your search.</p>
  <% end %>
</div>