
<div class="content-card mx-auto">
  <div class="row g-4 mb-5">
    <div class="col-md-6">
      <div class="product-image-block">
        <% if @product.image.attached? %>
          <%= image_tag @product.image, alt: @product.name %>
        <% end %>
      </div>
    </div>


    <div class="col-md-6 d-flex flex-column justify-content-center">
      <p class="eyebrow"><%= @product.category&.name || "Uncategorized" %></p>
      <h1 class="product-title mb-3"><%= @product.name %></h1>
      <p class="product-desc mb-4"><%= @product.description %></p>
      <p class="product-price mb-4"><%= number_to_currency(@product.price) %></p>
      <%= button_to "Add to Cart", cart_items_path(product_id: @product.id), class: "btn btn-outline-editorial align-self-start" %>
    </div>

    
  </div>

  <div class="related-section">
    <h2 class="related-heading mb-4">You <em>may</em> also like</h2>
    <div class="row row-cols-3 g-3">
      <% @related_products.each_with_index do |related, i| %>
        <div class="col">
          <%= link_to product_path(related), class: "text-decoration-none" do %>
            <div class="related-thumb <%= i == 0 ? 'variant-light' : (i == 2 ? 'variant-dark' : '') %>">
              <% if related.image.attached? %>
                <%= image_tag related.image.variant(resize_to_fill: [300, 300]), alt: related.name %>
              <% end %>
            </div>
            <p class="related-name"><%= related.name %></p>
            <p class="related-price"><%= number_to_currency(related.price) %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>