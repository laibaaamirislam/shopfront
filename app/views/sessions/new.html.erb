<div class="content-card mx-auto" style="max-width: 400px;">
  <h1 class="product-title mb-4">Log In</h1>

  <%= form_with url: login_path, method: :post, local: true do |form| %>
    <div class="mb-3">
      <%= form.label :email, class: "form-label" %>
      <%= form.email_field :email, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :password, class: "form-label" %>
      <%= form.password_field :password, class: "form-control" %>
    </div>

    <%= form.submit "Log In", class: "btn btn-outline-editorial" %>
  <% end %>

  <div class="mt-3 text-center">
    <p class="mb-0">Don't have an account? <%= link_to "Sign Up", new_user_path, class: "text-decoration-none" %></p>
  </div>
</div>